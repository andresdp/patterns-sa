{
  "system": {
    "name": "Arch Example System (Threshold)",
    "description": "ADEPT framework demonstration using Static Thresholds.",
    "components": {
      "arch_example_pattern": {
        "name": "Arch Example Pattern",
        "description": "A simple component-and-device pattern.",
        "parameters": {
          "deviceCPUCyles": { "data_type": "float", "type": "uncertainty", "level": "infrastructure" },
          "deviceCost": { "data_type": "float", "type": "constraint", "level": "infrastructure" },
          "lbExecTime": { "data_type": "float", "type": "uncertainty", "level": "pattern" },
          "lbFailureProb": { "data_type": "float", "type": "uncertainty", "level": "pattern" },
          "serviceCost": { "data_type": "float", "type": "constraint", "level": "pattern" },
          "serviceFailureProb": { "data_type": "float", "type": "uncertainty", "level": "pattern" },
          "d1Services": { "data_type": "integer", "type": "lever", "level": "system" },
          "d2Services": { "data_type": "integer", "type": "lever", "level": "system" },
          "d3Services": { "data_type": "integer", "type": "lever", "level": "system" }
        },
        "decisions": {
          "deployment_strategy": {
            "description": "The number of devices effectively deployed and the number of services per device.",
            "policies": {
              "one_device_low": { 
                "description": "0_0_1 configuration.",
                "parameter_bindings": {
                  "levers": {
                    "d1Services": 0,
                    "d2Services": 0,
                    "d3Services": 1
                  }
                }
              },
              "balanced_low": { 
                "description": "0_1_1 configuration.",
                "parameter_bindings": {
                  "levers": {
                    "d1Services": 0,
                    "d2Services": 1,
                    "d3Services": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "tradeoffs": [
      {
        "name": "SLA_Compliance",
        "description": "Cost under 100 and Success > 50%",
        "scheme": "threshold",
        "params": {
            "thresholds": { "cost": 100.0, "probSuccessfulExecution": 50.0 }
        },
        "elements": { "cost": "Satisfactory", "probSuccessfulExecution": "Satisfactory" }
      }
    ]
  },
  "dataspace": {
    "source_file": "data/merged.csv",
    "configuration_identification": {
      "from": "column",
      "column": "policy_config",
      "configurations": {
        "0_0_1": { 
          "name": "one_device_low", 
          "description": "Minimal configuration.", 
          "pattern_policy_references": [
            {
              "component": "arch_example_pattern",
              "decision": "deployment_strategy",
              "policy": "one_device_low"
            }
          ]
        },
        "0_1_1": { 
          "name": "balanced_low", 
          "description": "Balanced low-end configuration.", 
          "pattern_policy_references": [
            {
              "component": "arch_example_pattern",
              "decision": "deployment_strategy",
              "policy": "balanced_low"
            }
          ]
        }
      }
    },
    "quality_objectives": [
      { "name": "cost", "metric": "currency", "maximize": false },
      { "name": "executionTime", "metric": "time", "maximize": false },
      { "name": "probSuccessfulExecution", "metric": "probability", "maximize": true }
    ]
  },
  "metadata": {
    "version": "3.0",
    "notes": "Static threshold configuration. Updated to pattern-centric schema."
  }
}