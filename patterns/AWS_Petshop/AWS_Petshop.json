{
  "mode": "discovery",
  "system": {
    "name": "AWS Petshop System",
    "description": "A system for root cause analysis on a microservices application dataset from AWS.",
    "components": {
      "petshop_app": {
        "name": "AWS Petshop Application",
        "description": "A microservices-based application.",
        "parameters": {},
        "decisions": {
          "traffic_level": {
            "description": "The level of simulated traffic being sent to the system.",
            "policies": {
              "low": { "description": "Low traffic conditions." },
              "high": { "description": "High traffic conditions." }
            }
          }
        }
      }
    }
  },
  "dataspace": {
    "discovery_options": {
      "qa_naming_convention": {
        "type": "suffix",
        "separator": "#",
        "comment": "QAs are identified by columns ending in '#{target_service}'"
      },
      "parameter_identification": {
        "type": "all_except",
        "exclude_columns": ["traffic", "issue"]
      }
    },
    "policy_identification": {
      "from": "column",
      "column": "traffic",
      "policies": {
        "low_traffic": {
          "name": "low-traffic-system",
          "description": "System under low traffic.",
          "component_policies": { "petshop_app": "low" }
        },
        "high_traffic": {
          "name": "high-traffic-system",
          "description": "System under high traffic.",
          "component_policies": { "petshop_app": "high" }
        }
      }
    }
  },
  "metadata": {
    "version": "2.0",
    "notes": "This definition is for analyzing a single file in discovery mode. The user specifies the source file and target service at runtime."
  }
}