{
  "system": {
    "name": "Toy Example System",
    "description": "A simple example system for testing and demonstration.",
    "components": {
      "toy_model": {
        "name": "Toy Example",
        "description": "A simple component used for testing and demonstrating the analysis framework.",
        "parameters": {
          "deviceCPUCyles": { "type": "float" },
          "deviceCost": { "type": "float" },
          "lbExecTime": { "type": "float" },
          "lbFailureProb": { "type": "float" },
          "serviceCost": { "type": "float" },
          "serviceFailureProb": { "type": "float" }
        },
        "decisions": {
          "model_function": {
            "description": "The underlying mathematical function used to generate the data.",
            "policies": {
              "archexploration": { "description": "Default policy." }
            }
          }
        }
      }
    },
    "adaptive_processes": [],
    "tradeoffs": [
      {
        "name": "CostEfficiency",
        "description": "Low cost and high success probability",
        "elements": { "cost": "low", "probSuccessfulExecution": "high" },
        "paradigm": "discretization"
      },
      {
        "name": "Performance",
        "description": "Fast execution time",
        "elements": { "executionTime": "low" },
        "paradigm": "discretization"
      }
    ]
  },
  "dataspace": {
    "source_file": "merged.csv",
    "policy_identification": {
      "from": "column",
      "column": "model",
      "policies": {
        "archexploration": {
          "name": "standard-system",
          "description": "Standard configuration.",
          "component_policies": { "toy_model": "archexploration" }
        }
      }
    },
    "quality_objectives": [
      {
        "name": "cost",
        "metric": "currency",
        "maximize": false
      },
      {
        "name": "executionTime",
        "metric": "time",
        "maximize": false
      },
      {
        "name": "probSuccessfulExecution",
        "metric": "probability",
        "maximize": true
      }
    ]
  },
  "metadata": {
    "version": "2.0",
    "notes": "Updated to match actual Toy_Example data columns."
  }
}
