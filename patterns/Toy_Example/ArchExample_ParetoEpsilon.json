{
  "system": {
    "name": "Arch Example System (Epsilon)",
    "description": "ADEPT framework demonstration using Epsilon-Dominance.",
    "components": {
      "arch_example_pattern": {
        "name": "Arch Example Pattern",
        "description": "A simple component-and-device pattern.",
        "parameters": {
          "d1Services": { "data_type": "integer", "type": "lever", "level": "system" },
          "d2Services": { "data_type": "integer", "type": "lever", "level": "system" },
          "d3Services": { "data_type": "integer", "type": "lever", "level": "system" }
        }
      }
    },
    "tradeoffs": [
      {
        "name": "RobustlyOptimal",
        "description": "Solutions within 10% of the Pareto front.",
        "scheme": "pareto_epsilon",
        "params": {
            "epsilon": 0.10
        },
        "elements": { "cost": "Epsilon-Optimal", "probSuccessfulExecution": "Epsilon-Optimal" }
      }
    ]
  },
  "dataspace": {
    "source_file": "data/merged.csv",
    "policy_identification": {
      "from": "column",
      "column": "policy_config",
      "policies": {}
    },
    "quality_objectives": [
      { "name": "cost", "metric": "currency", "maximize": false },
      { "name": "executionTime", "metric": "time", "maximize": false },
      { "name": "probSuccessfulExecution", "metric": "probability", "maximize": true }
    ]
  },
  "metadata": {
    "version": "2.0",
    "notes": "Pareto Epsilon configuration."
  }
}
